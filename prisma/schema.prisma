generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POOLED")
}

model ContactlessPaymentTxOrMsg {
  uuid                     String    @id
  payloadType              String
  chainId                  String
  txParams                 Json?
  rpcProxySubmissionParams Json?
  additionalPayload        Json?
  dappName                 String?
  dappUrl                  String?
  txHash                   String?
  relayClaimedAt           DateTime? // for relay lock
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([createdAt]) // cron job performance
}